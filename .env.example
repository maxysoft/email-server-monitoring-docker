# --- Required ---
GOTIFY_URL=https://gotify.domain.tld
GOTIFY_TOKEN=token

# --- Target / what to probe ---
HOST=127.0.0.1
# Comma-separated NAME:PORT entries. Supported NAMEs: SMTP, SMTPS, IMAPS, HTTP, HTTPS
# (anything else falls back to a plain TCP connect).
SERVICES=SMTP:25,SMTPS:465,IMAPS:993,HTTPS:443
# Comma-separated status codes treated as "up" for HTTP and HTTPS probes (default 200).
# Widen if the service answers behind a redirect/auth gate, e.g. 200,301,302,401.
HTTP_EXPECTED_STATUS=200

# --- Container restart target ---
CONTAINER_NAME=stalwart
DOCKER_SOCKET=/var/run/docker.sock

# --- Scheduling ---
CHECK_INTERVAL_SECONDS=120

# --- Per-check tuning (normal cycle) ---
RETRIES=3
PER_ATTEMPT_TIMEOUT=5
SLEEP_BETWEEN_ATTEMPTS=5

# --- Post-restart verification ---
POST_RESTART_WAIT=15
POST_RESTART_PER_ATTEMPT_TIMEOUT=15
POST_RESTART_FINAL_TIMEOUT=60
POST_RESTART_POLL_INTERVAL=10

# --- Notifications ---
GOTIFY_PRIORITY=5
